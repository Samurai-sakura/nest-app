# Postgres: эти же значения использует docker-compose.yml
POSTGRES_USER=db_user
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=backend_app_db
POSTGRES_PORT=5432
DB_HOST=localhost

# Приложение. APP_URL подставляется в ссылку из письма
PORT=3200
APP_URL=http://localhost:3200
# Доверенный frontend: только origin, без пути и слеша в конце
FRONTEND_ORIGIN=http://localhost:3200
# Внешний адрес API: из него строится photoUrl в профиле. Вне localhost только https,
# без query и fragment; путь допускается, например https://api.example.com/v1
PUBLIC_API_BASE_URL=http://localhost:3200
# Необязательно: none, если frontend на другом site (другой домен), иначе strict
# AUTH_COOKIE_SAME_SITE=strict

# Подтверждение email при регистрации
# true — аккаунт ждёт подтверждения, false — сразу активен
REGISTRATION_CONFIRM_ENABLED=true
# otp — код из письма, magic_link — ссылка из письма
REGISTRATION_CONFIRM_METHOD=otp

# Rate limit: не больше LIMIT запросов за TTL секунд
# отдельно для регистрации и для повторной отправки письма
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_TTL_SECONDS=60

# Подтверждение входа по email, независимо от регистрации
LOGIN_EMAIL_CONFIRMATION_ENABLED=false
LOGIN_EMAIL_CONFIRMATION_METHOD=otp

# Подтверждение смены email: otp или magic_link, письмо уходит на новый адрес
EMAIL_CHANGE_METHOD=otp

# JWT: issuer и audience проверяются при каждом запросе
JWT_ISSUER=backend-app
JWT_AUDIENCE=backend-app

# RBAC: id существующего пользователя, которому первая загрузка назначит роль admin.
# Нужен только при старте с пустыми таблицами RBAC, дальше роли меняются через API
# RBAC_BOOTSTRAP_ADMIN_USER_ID=

# Ключи: каждый сгенерировать отдельно командой openssl rand -hex 32
# Не короче 32 байт и все разные, иначе приложение не запустится
CONFIRMATION_HMAC_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
LOGIN_CHALLENGE_HMAC_KEY=
LOG_EMAIL_HMAC_KEY=
EMAIL_CHANGE_HMAC_KEY=

# Хранилище фотографий: local — папка на диске, только для разработки и одного экземпляра;
# s3 — S3-совместимое хранилище, обязательно при NODE_ENV=production
PHOTO_STORAGE_DRIVER=local
# PHOTO_STORAGE_DIR=storage/photos

# S3: значения по умолчанию подходят к RustFS из docker-compose.yml
# Ключи RustFS — только заглавные латинские буквы и цифры
# S3_ENDPOINT=http://localhost:9000
# S3_REGION=us-east-1
# S3_BUCKET=backend-app-photos
# S3_ACCESS_KEY_ID=BACKENDAPPDEV
# S3_SECRET_ACCESS_KEY=BACKENDAPPDEVSECRET2026
# Создать бакет при старте, если его нет: удобно для разработки, в production бакет создаётся заранее
# S3_CREATE_BUCKET=true

# Почта: по умолчанию локальный перехватчик Mailpit из docker-compose.yml
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@backend-app.local
