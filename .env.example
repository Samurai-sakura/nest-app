# Postgres: эти же значения использует docker-compose.yml
POSTGRES_USER=db_user
POSTGRES_PASSWORD=postgrespassword
POSTGRES_DB=backend_app_db
POSTGRES_PORT=5432
DB_HOST=localhost

# Приложение. APP_URL подставляется в ссылку из письма
PORT=3200
APP_URL=http://localhost:3200
# Доверенный frontend: только origin, без пути и слеша в конце
FRONTEND_ORIGIN=http://localhost:3200
# Необязательно: none, если frontend на другом site (другой домен), иначе strict
# AUTH_COOKIE_SAME_SITE=strict

# Подтверждение email при регистрации
# true — аккаунт ждёт подтверждения, false — сразу активен
REGISTRATION_CONFIRM_ENABLED=true
# otp — код из письма, magic_link — ссылка из письма
REGISTRATION_CONFIRM_METHOD=otp

# Rate limit: не больше LIMIT запросов за TTL секунд
# отдельно для регистрации и для повторной отправки письма
REGISTRATION_RATE_LIMIT=5
REGISTRATION_RATE_TTL_SECONDS=60

# Подтверждение входа по email, независимо от регистрации
LOGIN_EMAIL_CONFIRMATION_ENABLED=false
LOGIN_EMAIL_CONFIRMATION_METHOD=otp

# JWT: issuer и audience проверяются при каждом запросе
JWT_ISSUER=backend-app
JWT_AUDIENCE=backend-app

# Ключи: каждый сгенерировать отдельно командой openssl rand -hex 32
# Не короче 32 байт и все разные, иначе приложение не запустится
CONFIRMATION_HMAC_SECRET=
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=
LOGIN_CHALLENGE_HMAC_KEY=
LOG_EMAIL_HMAC_KEY=

# Почта: по умолчанию локальный перехватчик Mailpit из docker-compose.yml
SMTP_HOST=localhost
SMTP_PORT=1025
MAIL_FROM=no-reply@backend-app.local
